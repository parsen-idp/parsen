<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Necessário para o dotnet user-jwts guardar a chave de assinatura dos tokens de desenvolvimento -->
    <UserSecretsId>parsen-api-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.AspNetCoreServer.Hosting" />
    <!-- Configuração dos clientes AWS a partir do appsettings (usa reflexão: fica na API, fora dos workers AOT) -->
    <PackageReference Include="AWSSDK.Extensions.NETCore.Setup" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <!-- Só em desenvolvimento: permite ao SDK usar as credenciais do "aws login" (AWS__Profile=parsen).
       Na Lambda as credenciais vêm da role da função, então o pacote não vai para o build Release. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="AWSSDK.Signin" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Parsen.Infrastructure\Parsen.Infrastructure.csproj" />
  </ItemGroup>

</Project>
