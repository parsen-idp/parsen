<Project Sdk="Microsoft.NET.Sdk">

  <!-- Lambda do gatilho Pre Token Generation do Cognito: Native AOT no runtime provided.al2023 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- O runtime provided.al2023 executa um arquivo chamado "bootstrap" -->
    <AssemblyName>bootstrap</AssemblyName>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.Core" />
    <PackageReference Include="Amazon.Lambda.RuntimeSupport" />
    <PackageReference Include="AWSSDK.DynamoDBv2" />
  </ItemGroup>

</Project>
