<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Domínio">
    <PackageVersion Include="Ulid" Version="1.4.1" />
  </ItemGroup>
  <ItemGroup Label="AWS SDK">
    <PackageVersion Include="AWSSDK.DynamoDBv2" Version="4.0.107.3" />
    <PackageVersion Include="AWSSDK.EventBridge" Version="4.0.101.5" />
    <PackageVersion Include="AWSSDK.S3" Version="4.0.104.4" />
    <PackageVersion Include="AWSSDK.Extensions.NETCore.Setup" Version="4.0.102.4" />
    <PackageVersion Include="AWSSDK.Signin" Version="4.0.101.15" />
  </ItemGroup>
  <ItemGroup Label="Lambda">
    <PackageVersion Include="Amazon.Lambda.Core" Version="3.4.0" />
    <PackageVersion Include="Amazon.Lambda.RuntimeSupport" Version="2.3.0" />
    <PackageVersion Include="Amazon.Lambda.Serialization.SystemTextJson" Version="3.0.1" />
    <PackageVersion Include="PDFtoImage" Version="5.4.0" />
  </ItemGroup>
  <ItemGroup Label="API">
    <PackageVersion Include="Amazon.Lambda.AspNetCoreServer.Hosting" Version="2.2.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup Label="Infraestrutura (CDK)">
    <PackageVersion Include="Amazon.CDK.Lib" Version="2.273.0" />
    <PackageVersion Include="Constructs" Version="10.8.1" />
  </ItemGroup>
  <ItemGroup Label="Testes">
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="Testcontainers.DynamoDb" Version="4.16.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
</Project>
